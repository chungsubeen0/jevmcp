{
  "mcpServers": {
    "jev": {
      "command": "jev-mcp",
      "args": ["--profile", "autonomous", "--shadow"],
      "env": {
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY}",
        "TYPESAFE_MODEL": "jev-latest",
        "JEV_MCP_PROFILE": "autonomous",
        "JEV_MCP_SHADOW_MODE": "true"
      }
    }
  }
}
