# TypeSafe / Jev credentials. Never commit real values.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=30

# Optional Jev MCP overrides
# JEV_MCP_CONFIG=
# JEV_MCP_PROVIDER=typesafe
# JEV_MCP_PROFILE=interactive
# JEV_MCP_LOG_LEVEL=INFO
# JEV_MCP_SHADOW_MODE=true
# TYPESAFE_ALLOWED_HOSTS=api.typesafe.ai
# JEV_MCP_ALLOW_FAULTS=
# JEV_MCP_DATA_DIR=
